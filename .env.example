# Copier ce fichier en .env.local pour le développement, et renseigner les mêmes
# variables dans Netlify (Site configuration > Environment variables).
# NE JAMAIS committer de vraies valeurs.

# Supabase > Connect > ORMs/Transaction pooler (port 6543). Remplacer [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Supabase > Project Settings > API (clé publique "anon" / "publishable")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Adresse publique du site (sans / final)
SITE_URL=https://belavica.com

# E-mail(s) autorisé(s) à accéder à /admin (séparés par des virgules)
ADMIN_EMAILS=leona@belavica.com

# Secrets aléatoires (32 caractères minimum) : générer avec  openssl rand -base64 36
APP_SECRET=
CRON_SECRET=
IP_HASH_SALT=

# Resend (e-mails) — https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=BELAVICA <reservations@belavica.com>

# Cloudflare Turnstile (anti-robot, facultatif mais recommandé)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
